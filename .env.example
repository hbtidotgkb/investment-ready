# Copy to .env (git-ignored) or store with `ca secrets set NAME` (OS keychain, preferred).
# Keys are read from the OS keychain first, then environment / .env.

# Anthropic — powers every brain (Quant, News, Forensic, Head, Critic) in this build.
ANTHROPIC_API_KEY=

# OpenAI — only needed if you assign a role (e.g. Critic) to OpenAI in System → Models.
OPENAI_API_KEY=

# Zerodha Kite Connect (read-only use). Register an app at https://developers.kite.trade
# and set its redirect URL to http://127.0.0.1:8765/kite/callback
KITE_API_KEY=
KITE_API_SECRET=

# Optional: identify the client politely to public archives (no personal email needed)
CA_HTTP_USER_AGENT=PersonalCA/0.2 (personal research; contact via GitHub)
