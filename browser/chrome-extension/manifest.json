{
  "manifest_version": 3,
  "name": "Personal CA — Research Capture",
  "version": "0.6.0",
  "description": "Capture articles you can already read (e.g. ET Prime) — single pages or a queued list — into your local Personal CA research inbox, with passages and provenance.",
  "permissions": ["sidePanel", "scripting", "activeTab", "storage", "alarms"],
  "optional_host_permissions": ["https://economictimes.indiatimes.com/*"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Personal CA — open capture panel" },
  "externally_connectable": { "matches": ["http://127.0.0.1/*", "http://localhost/*"] },
  "minimum_chrome_version": "116"
}
